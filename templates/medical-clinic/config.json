{
  "templateId": "medical-clinic",
  "selfContainedNav": true,
  "defaultPalette": "medical-teal",
  "defaultPrimaryColor": "#063a3f",
  "defaultTypeLabel": "Medical \u00b7 Health \u00b7 Wellness",
  "showOpenBadge": true,
  "showHoursGrid": true,
  "navCtaLabel": "Book Appointment",
  "navLinks": [
    "#services:Services",
    "#team:Our Team",
    "#insurance:Insurance",
    "#contact:Contact"
  ],
  "googleFonts": "https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap",
  "typeLabels": {
    "medical-clinic": "Medical \u00b7 Health \u00b7 Wellness",
    "clinic": "Medical Clinic",
    "dental": "Dental Practice",
    "physio": "Physiotherapy Practice"
  },
  "lists": [
    {
      "key": "services",
      "emptyHtml": "<p style=\"text-align:center;padding:40px;color:var(--muted)\">Services will be listed here soon.</p>",
      "itemTemplate": "<div class=\"mc-svc\"><div class=\"mc-svc-icon\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.5 4.04 3 5.5l7 7Z\"/></svg></div><div class=\"mc-svc-body\"><div class=\"mc-svc-name\">{{item.name}}</div>{{#if item.description}}<div class=\"mc-svc-desc\">{{item.description}}</div>{{/if}}</div>{{#if item.price}}<div class=\"mc-svc-price\">{{item.price}}</div>{{/if}}</div>"
    },
    {
      "key": "team",
      "emptyHtml": "<p style=\"text-align:center;padding:40px;color:var(--muted)\">Our practitioners will be listed here soon.</p>",
      "itemTemplate": "<div class=\"mc-doc\">{{#if item.photo}}<img class=\"mc-doc-photo\" src=\"{{item.photo}}\" alt=\"{{item.name}}\">{{else}}<div class=\"mc-doc-photo mc-doc-photo-ph\"><svg viewBox=\"0 0 24 24\" width=\"36\" height=\"36\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/></svg></div>{{/if}}<div class=\"mc-doc-name\">{{item.name}}</div>{{#if item.role}}<div class=\"mc-doc-role\">{{item.role}}</div>{{/if}}{{#if item.bio}}<p class=\"mc-doc-bio\">{{item.bio}}</p>{{/if}}</div>"
    },
    {
      "key": "testimonials",
      "emptyHtml": "",
      "itemTemplate": "<div class=\"mc-testi\"><p class=\"mc-testi-text\">\"{{item.text}}\"</p><div class=\"mc-testi-name\">{{item.name}}</div></div>"
    },
    {
      "key": "gallery",
      "emptyHtml": "",
      "itemTemplate": "<img src=\"{{item.url}}\" alt=\"{{item.caption}}\" loading=\"lazy\">"
    },
    {
      "key": "insurance",
      "emptyHtml": "",
      "itemTemplate": "<span class=\"mc-ins-chip\">{{item.name}}</span>"
    }
  ],
  "conditionals": [
    {
      "flag": "logo_url",
      "type": "computed",
      "token": "logo_url"
    },
    {
      "flag": "hero_image_url",
      "type": "computed",
      "token": "hero_image_url"
    },
    {
      "flag": "has_services",
      "type": "list_present",
      "field": "services"
    },
    {
      "flag": "has_team",
      "type": "list_present",
      "field": "team"
    },
    {
      "flag": "has_testimonials",
      "type": "list_present",
      "field": "testimonials"
    },
    {
      "flag": "has_gallery",
      "type": "list_present",
      "field": "gallery"
    },
    {
      "flag": "has_insurance",
      "type": "list_present",
      "field": "insurance"
    },
    {
      "flag": "has_bookable_services",
      "type": "computed",
      "token": "has_bookable_services"
    },
    {
      "flag": "phone",
      "type": "field_present",
      "field": "phone"
    },
    {
      "flag": "email",
      "type": "field_present",
      "field": "email"
    },
    {
      "flag": "location",
      "type": "field_present",
      "field": "location"
    },
    {
      "flag": "map_embed_url",
      "type": "field_present",
      "field": "map_embed_url"
    },
    {
      "flag": "show_reviews_section",
      "type": "computed",
      "token": "show_reviews_section"
    }
  ]
}